# Android: public project URL and publishable/anon key only, supplied to Gradle at build time.
SUPABASE_URL=https://your-project-ref.supabase.co
# Never copy SUPABASE_SERVICE_ROLE_KEY into the Android project or APK.
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxx

# Edge Function environment only (set with supabase secrets, do not commit).
SUPABASE_SERVICE_ROLE_KEY=replace-in-supabase-dashboard-only
